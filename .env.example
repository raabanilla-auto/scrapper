# Postgres connection string used by Prisma (see prisma/schema.prisma).
# Any Postgres-compatible provider works (Neon, Supabase, Railway, RDS, local Postgres, etc.).
# The app runs fine without this set — it falls back to browser localStorage
# only, which is what makes it usable offline as a PWA. Fill this in when
# you're ready to add server-side persistence / multi-device sync.
DATABASE_URL="postgresql://user:password@localhost:5432/scrap_ledger?schema=public"
